# Application
APP_ENV=development
APP_NAME=VertOps API
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Redis
# For SQLite local development: sqlite+aiosqlite:///./vertops.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/vertops
DATABASE_URL=sqlite+aiosqlite:///./vertops.db
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
FIELD_ENCRYPTION_KEY=super_secure_32_byte_dev_secret_key_123456=

# WhatsApp Configuration
WHATSAPP_PROVIDER=mock
META_GRAPH_API_VERSION=v19.0
META_ACCESS_TOKEN=EAAG...
META_APP_SECRET=...
META_PHONE_NUMBER_ID=...
META_WABA_ID=...
META_WEBHOOK_VERIFY_TOKEN=vertops_secure_verify_token_2026

# AI Configuration (Optional)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Object Storage (CSV Imports/Exports)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=vertops-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
